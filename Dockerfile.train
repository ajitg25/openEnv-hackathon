FROM nvidia/cuda:12.1.1-runtime-ubuntu22.04

RUN apt-get update && \
    apt-get install -y --no-install-recommends python3 python3-venv python3-pip git curl && \
    ln -sf /usr/bin/python3 /usr/bin/python && \
    rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir \
    "unsloth[cu121] @ git+https://github.com/unslothai/unsloth.git" \
    trl peft accelerate nest_asyncio \
    pydantic fastapi uvicorn websockets httpx matplotlib numpy

RUN pip3 install --no-cache-dir --no-deps "openenv-core>=0.2.2"

RUN useradd -m -u 1000 appuser
WORKDIR /app
COPY . .
RUN mkdir -p /app/plots && chown -R appuser:appuser /app
USER appuser

ENV PYTHONPATH="/app/envs:/app:$PYTHONPATH"
ENV AMBULANCE_DIFFICULTY="easy"

EXPOSE 7860

# Train, then serve results as a simple file server so you can download plots
CMD ["sh", "-c", "python3 /app/train.py && echo 'Training complete. Serving plots...' && cd /app/plots && python3 -m http.server 7860"]
